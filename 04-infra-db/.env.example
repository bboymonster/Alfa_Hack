# ==============================================================================
# Configuration: Alfa News Insights (04-infra-db)
# ==============================================================================

# PostgreSQL Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=alfa_news
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Database Connection URLs
# For Docker network:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/alfa_news
# For local host (direct python scripts):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alfa_news
# Fallback SQLite:
SQLITE_DB_PATH=./alfa_business.db

# Security & JWT
JWT_SECRET_KEY=supersecretjwtkey_change_in_production_1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers (Approved list from Case Appendix 3)
LLM_PROVIDER=deepseek
LLM_API_KEY=your_api_key_here
LLM_MODEL=deepseek-v4.1-flash

# Необязательно для первого запуска. Файл .env не отправляем в Git.
# Если ключ пустой, backend создаёт временный ключ при каждом запуске.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# 03-ai-service (в Docker Compose задаётся автоматически: http://ai-service:8001)
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT_S=60
AI_SERVICE_ENABLED=true

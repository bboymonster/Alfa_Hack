# App Config
PROJECT_NAME="Alfa News Insights"
ENVIRONMENT=development

# Database (PostgreSQL / SQLite)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alfa_news
# Для локальной разработки без Docker:
# DATABASE_URL=sqlite:///./alfa_news.db

# Authentication / JWT
JWT_SECRET_KEY=supersecretjwtkey_change_in_production_1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers (Разрешенные модели по ТЗ кейса)
# DeepSeek-V4.1-Flash / Qwen3.6 35B / GLM-5.3-Flash / Gemma 4 / Kimi-K2.6
LLM_PROVIDER=deepseek
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4.1-flash

# Ports & CORS
PORT=8000
VITE_API_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# App Config
PROJECT_NAME="Alfa News Insights"
ENVIRONMENT=development

# Database (PostgreSQL / SQLite)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alfa_news
# Либо для локальной быстрой разработки без Docker:
# DATABASE_URL=sqlite:///./alfa_news.db

# Authentication / JWT
JWT_SECRET_KEY=supersecretjwtkey_change_in_production_1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / LLM Configuration
# Укажите ключ вашего провайдера:
OPENAI_API_KEY=
GEMINI_API_KEY=
# Или URL локального сервиса (например, Ollama):
OLLAMA_BASE_URL=http://localhost:11434

# Backend & Frontend Ports
PORT=8000
VITE_API_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

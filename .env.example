# ==============================================================================
# Alfa News Insights — конфигурация (корень репозитория)
# Скопируйте в .env:  cp .env.example .env
# Все переменные необязательны — есть безопасные значения по умолчанию.
# ==============================================================================

# --- Аутентификация / JWT (backend) ---
JWT_SECRET_KEY=supersecretjwtkey_change_in_production_1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Backend → AI-service ---
# При true backend обращается к 03-ai-service (offline/llm); при недоступности —
# честно помеченная детерминированная заглушка. false — всегда заглушка.
AI_SERVICE_ENABLED=true
AI_SERVICE_TIMEOUT_S=60

# --- AI-service: разрешённые модели (Приложение 3 ТЗ) ---
# Без ключа сервис работает в режиме offline (детерминированные инсайты и
# трассировка агента). С ключом — реальные модели; id уточняйте у провайдера
# (OpenRouter / vLLM и т.п.).
AI_LLM_BASE_URL=https://openrouter.ai/api/v1
AI_LLM_API_KEY=
AI_LLM_MODEL_MAIN=deepseek/deepseek-v4.1-flash
AI_LLM_MODEL_FAST=google/gemma-4-26b-a4b-it
AI_LLM_MODEL_CHECKER=z-ai/glm-5.3-flash

# --- Порты (host) ---
# Если стандартные порты заняты на вашей машине, переопределите их в .env.
FRONTEND_PORT=3000
BACKEND_PORT=8000
AI_SERVICE_PORT=8001
